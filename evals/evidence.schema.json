{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-godot/evidence.schema.json",
  "title": "Godot skill evaluation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "gates", "scores"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/gate"
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dimension"
      }
    },
    "run_metadata": {
      "type": "object"
    },
    "project_disposition": {
      "$ref": "#/$defs/project_disposition"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "evidence_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "context"],
      "properties": {
        "role": {
          "enum": ["builder", "independent", "human", "provider", "product_owner"]
        },
        "context": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["image", "video", "review", "report", "trace", "log", "audio", "build"]
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "project_disposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "const": "active"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "decision_owner", "context", "reason", "continue_authorized"],
          "properties": {
            "status": {
              "const": "user_closed"
            },
            "decision_owner": {
              "enum": ["user", "product_owner"]
            },
            "context": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "continue_authorized": {
              "const": false
            }
          }
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": ["pass", "fail", "not_tested"]
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "dimension": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "evidence"],
          "properties": {
            "status": {
              "const": "scored"
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "const": "not_applicable"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
